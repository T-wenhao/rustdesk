# Custom RustDesk Configuration Example
# Copy this file to .env.custom and fill in your values

# Required: Client authentication key
CUSTOM_CLIENT_KEY=your-client-key-here

# Required: Rendezvous server hostname (without protocol)
CUSTOM_RENDEZVOUS_SERVER=your-server.example.com

# Optional: API server URL (with protocol)
CUSTOM_API_SERVER=https://api.your-server.example.com

# Optional: Relay server URL (with protocol)
CUSTOM_RELAY_SERVER=https://relay.your-server.example.com

# Optional: Build type (debug/release)
BUILD_TYPE=release

# Optional: Target platform (linux/windows/macos)
# Leave empty for auto-detection
TARGET_PLATFORM=